  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx scripts/check-assets.ts && npx tsx scripts/check-destinations.ts && vite",
    "build": "npx tsx scripts/check-assets.ts && npx tsx scripts/check-destinations.ts && tsc -b && vite build",
