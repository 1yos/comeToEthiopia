# ── Come to Ethiopia Tours — Environment Variables ──────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Admin panel password. Change this before deploying.
# Default (if unset): admin123
VITE_ADMIN_PASSWORD=your-secure-password-here

# ── Future integrations (not yet used) ──────────────────────────────────────
# Google Gemini API for AI-powered route recommendations (routeScorer.ts)
# VITE_GEMINI_API_URL=

# Google Maps API key (if switching from OSM tiles)
# VITE_GOOGLE_MAPS_API_KEY=
